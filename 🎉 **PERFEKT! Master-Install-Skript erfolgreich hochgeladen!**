## 📊 **NACH INSTALLATION:**

```bash
# Neue Shell starten
exec $SHELL

# Test PostgreSQL
psql -d research_dev -c "SELECT version();"

# Test MongoDB
mongo --eval "db.adminCommand('ping')"

# Test Redis
redis-cli ping

# Test Docker
docker run hello-world

# Transkription
~/.local/bin/transcribe.sh video.mp3 de

# Disk-Analyse
~/.local/bin/analyze-disk.sh

# Automatisches Backup
~/.local/bin/backup-all.sh

# Admin Panels (Docker)
cd ~/.config/masterplan
docker-compose up -d

# pgAdmin auf Browser
# http://localhost:5050 (admin@example.com/admin)

# DBeaver
dbeaver

# Jupyter Lab
jupyter lab
```

